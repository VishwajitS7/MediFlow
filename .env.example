# ==============================================================================
# MediFlow — Canonical Environment Variable Template
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO THIS FILE.
# Copy this file to .env.local for local development.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# Database Configuration (MongoDB Atlas)
# Replace placeholders with your sandbox or development cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mediflow?retryWrites=true&w=majority

# Authentication Configuration (Auth.js / NextAuth)
# Local development base URL
NEXTAUTH_URL=http://localhost:3000
# Generate a secure 32-character secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long

# Optional Clinic Configuration
CLINIC_NAME="MediFlow Smart Clinic"
CLINIC_TIMEZONE="UTC"
