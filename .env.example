# ==============================================================================
# MediFlow — Canonical Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (MongoDB Atlas / Mongoose)
# Required by: src/lib/db/mongodb.ts & scripts/seed-demo-users.mjs
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mediflow?retryWrites=true&w=majority

# Authentication Configuration (Auth.js / NextAuth)
# Required by: NextAuth session routing, cookie domain, and JWT cryptographic signing
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long

# Clinic Operations (IANA Time Zone)
# Required by: Daily queue token resets and appointment calendar date filtering
# Default: UTC if omitted. Recommended: Clinic's local IANA zone (e.g. Asia/Kolkata)
CLINIC_TIMEZONE=Asia/Kolkata
